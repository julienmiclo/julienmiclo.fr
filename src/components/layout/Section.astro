---
import type {HTMLAttributes} from 'astro/types';
import {twMerge} from 'tailwind-merge';
import Wave from '@/components/ui/Wave.astro';

interface Props extends HTMLAttributes<'section'> {
    id: string;
    wave?: boolean;
}

const {id, wave = false, class: className, ...rest} = Astro.props;
const waveClass = 'group-first-of-type/section:-mt-40 mb-8 -mx-6 w-[calc(100%+--spacing(12))] sm:-mx-10 sm:w-[calc(100%+--spacing(20))]';
---

<section id={id} class={twMerge('group/section flex flex-col max-w-2xl w-full px-0 sm:px-12', className)} {...rest}>
	<div class="w-full grow sm:border-x border-accent px-6 sm:px-10 group-first-of-type/section:pt-48 pb-48">
        {wave &&
			<Wave class={waveClass}/>}
		<slot/>
	</div>
</section>
