---
import type {HTMLAttributes} from 'astro/types';
import {twMerge} from 'tailwind-merge';

type Props = HTMLAttributes<'svg'>;

// Ruban décoratif. Ses extrémités sont coupées à la verticale pour venir buter contre les bordures de la colonne :
// la largeur de la viewBox correspond exactement au bord droit du tracé.
const {class: className, ...rest} = Astro.props;
---

<svg
	viewBox="0 0 557.639 215"
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
	class={twMerge('block h-auto w-full text-accent', className)}
    {...rest}
>
