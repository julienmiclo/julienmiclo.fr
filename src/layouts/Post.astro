---
import type {GetStaticPaths, InferGetStaticPropsType} from 'astro';
import {getCollection, render} from 'astro:content';
import Column from "@/components/layout/Column.astro";
import Section from "@/components/layout/Section.astro";
import {mdxComponents} from "@/components/mdx";
import Heading from "@/components/ui/Heading.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Text from "@/components/ui/Text.astro";

interface Props {
    item: any;
}

const {item} = Astro.props;
const {Content} = await render(item);
---
<Column as="main" id="main" align="center" class="min-h-dvh bg-surface overflow-hidden">
	<Section id="post" class="grow">
		<div class="mb-10">
			<ButtonLink href="/posts/"><span aria-hidden="true">←</span> Tous les articles</ButtonLink>
		</div>
		<article>
			<Heading level={1} class="mb-3">{item.data.title}</Heading>
			<Text size="sm" class="mb-10 text-gray-600">Publié le <time
				datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('fr-FR', {dateStyle: 'long'})}</time>
			</Text>
			<Content components={mdxComponents}/>
		</article>
		<div class="mt-12">
			<ButtonLink href="/posts/"><span aria-hidden="true">←</span> Tous les articles</ButtonLink>
		</div>
	</Section>
</Column>
