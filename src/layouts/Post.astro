---
import type {CollectionEntry} from 'astro:content';
import {render} from 'astro:content';
import Page from '@/layouts/Page.astro';
import {mdxComponents} from '@/components/mdx';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Text from '@/components/ui/Text.astro';
import content from '@/data/content.json';

interface Props {
    post: CollectionEntry<'posts'>;
}

const {post} = Astro.props;
const {Content} = await render(post);

const description = post.data.description ?? post.data.title;
const back = {href: '/posts/', label: 'Tous les articles'};

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    datePublished: post.data.date.toISOString(),
    author: {'@type': 'Person', name: content.contact.fullname},
};
---

<Page id="post" title={post.data.title} description={description} type="article" back={back} as="article">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
	<meta slot="head" property="article:published_time" content={post.data.date.toISOString()}/>
	<Fragment slot="subtitle">
		<Text size="sm" class="text-gray-600">Publié le
			<time
				datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('fr-FR', {dateStyle: 'long'})}</time>
		</Text>
	</Fragment>
	<Content components={mdxComponents}/>
	<div slot="after" class="mt-12">
		<ButtonLink href={back.href}><span aria-hidden="true">←</span> {back.label}</ButtonLink>
	</div>
</Page>
