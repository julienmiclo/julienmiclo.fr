---
import Column from '@/components/layout/Column.astro';
import Section from '@/components/layout/Section.astro';
import Heading from '@/components/ui/Heading.astro';
import PostList from '@/components/site/PostList.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';

import {getPosts} from '@/utils/content';

const posts = await getPosts();
---

<Column as="main" id="main" align="center" class="min-h-dvh bg-surface overflow-hidden">
	<Section id="posts" class="grow" wave>
		<div class="mb-10">
			<ButtonLink href="/"><span aria-hidden="true">←</span> Retour à l'accueil</ButtonLink>
		</div>
		<Heading level={1} class="mb-10">Articles</Heading>
		<PostList posts={posts}/>
	</Section>
</Column>
